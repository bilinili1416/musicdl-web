# Set these values in Railway Variables, not in the repository.
MUSICDL_USERNAME=musicdl
MUSICDL_PASSWORD=
# Minimum 16 characters; use a randomly generated password.
# Mount a persistent Railway volume at /data.
MUSICDL_DATA_DIR=/data
HOST=0.0.0.0
# Railway supplies PORT and RAILWAY_PUBLIC_DOMAIN automatically.
# For a custom domain, set its exact origin, such as:
# MUSICDL_PUBLIC_ORIGIN=https://music.example.com
